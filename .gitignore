# ---- 環境・秘密 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- OS・エディタ ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Python（worker） ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Go（backend） ----
/backend/bin/
*.test
*.out

# ---- 管理画面（backend/admin：React + TypeScript + Tailwind） ----
node_modules/
backend/admin/dist/
*.tsbuildinfo
npm-debug.log*
# Docker のビルドで、管理画面の成果物が入る場所。Go の embed に最低 1 ファイル要るので、案内の index.html だけは残す
backend/web/admin_dist/*
!backend/web/admin_dist/index.html

# ---- モデルの重み（初回の起動時に、自動でダウンロードされる。大きい） ----
worker/models/*
!worker/models/.gitkeep
*.tflite
*.pth
*.onnx
*.pt

# ---- 使わないもの置き場（_unused）の、大きなデータ・生成物 ----
_unused/data/
_unused/outputs/
_unused/**/*.mp4
_unused/**/*.mov
_unused/**/*.jpg

# ---- ログ・一時ファイル ----
*.log
tmp/
